# Optional settings for the box container. Copy to box.env (chmod 600).
# Keys here stay on the server; the app can add keys of its own, and a provider
# the app doesn't send falls back to these. The box removes them from its
# environment at start, so MCP servers and Claude Code never inherit them.
#XAI_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#E2B_API_KEY=
#WISP_BOX_CUSTOM_BASE_URL=https://openrouter.ai/api/v1
#WISP_BOX_CUSTOM_API_KEY=
#WISP_BOX_DEFAULT_MODEL=anthropic:claude-opus-5-5
# The providers' own web search, and X search for Grok, are on unless the app turns them off.
#WISP_BOX_WEB_SEARCH=off
#WISP_BOX_X_SEARCH=off

# A token of your own instead of the generated /data/gateway-token (at least 32 characters: openssl rand -hex 32).
#WISP_BOX_TOKEN=

# Refuse configuration from the app; models and keys then come only from here.
#WISP_BOX_ADMIN=off
